{
  "name": "Stonks",
  "short_name": "Stonks",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#151117",
  "theme_color": "#151117",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "description": "See what moved today and what your stocks, ETFs and crypto are worth — no trading, no tips, just your numbers.",
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            ".pdf",
            "text/csv",
            ".csv"
          ]
        }
      ]
    }
  }
}
